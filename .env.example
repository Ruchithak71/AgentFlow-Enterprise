# ============================================================
# AgentFlow-Enterprise — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ============================================================

# ---- AI Provider Keys ----
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ---- Redis (local Docker) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ---- Redis (Upstash — for production use) ----
# REDIS_HOST=direct-xxxx.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your-upstash-token
# REDIS_SSL=true

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
QUEUE_NAME=sap_ai_tasks_queue

# ---- Worker Tuning ----
CACHE_TTL_SECONDS=3600

# ---- PostgreSQL (Spring Boot) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/agentflow_db
SPRING_DATASOURCE_USERNAME=agentflow_user
SPRING_DATASOURCE_PASSWORD=agentflow_password

# ---- Spring Boot Security ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# ---- Spring Boot RabbitMQ (overrides application.properties defaults) ----
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# ---- Spring Boot Redis ----
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
